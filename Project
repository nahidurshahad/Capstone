
#include <stdio.h>
#include <string.h>

int main() {

    int choice, found;
    char email[50], password[30];
    char savedEmail[50], savedPassword[30];

    char domain1[] = "@gmail.com";
    char domain2[] = "@diu.edu.bd";

    FILE *file;

    while (1) {

        printf("\nLIBRARY MANAGEMENT SYSTEM\n");
        printf("1. Registration\n");
        printf("2. Login\n");
        printf("3. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        if (choice == 1) {

            printf("\nREGISTRATION\n");

            printf("Enter Email: ");
            scanf("%49s", email);

            int length = strlen(email);

            if (length < 10 ||
                (strcmp(email + length - 10, domain1) != 0 &&
                (length < 11 ||
                strcmp(email + length - 11, domain2) != 0))) {

                printf("Invalid Email! Use gmail.com or diu.edu.bd\n");
                continue;
            }

            printf("\nPassword Requirements:\n");
            printf("1. Minimum 8 characters\n");
            printf("2. At least 1 Uppercase letter (A-Z)\n");
            printf("3. At least 1 Lowercase letter (a-z)\n");
            printf("4. At least 1 Number (0-9)\n");
            printf("5. At least 1 Special character (@,#,$,!)\n");

            printf("\nEnter Password: ");
            scanf("%29s", password);

            int upper = 0, lower = 0, digit = 0, special = 0;

            if (strlen(password) < 8) {
                printf("Password must be at least 8 characters!\n");
                continue;
            }

            for (int i = 0; password[i] != '\0'; i++) {

                if (password[i] >= 'A' && password[i] <= 'Z') {
                    upper = 1;
                }
                else if (password[i] >= 'a' && password[i] <= 'z') {
                    lower = 1;
                }
                else if (password[i] >= '0' && password[i] <= '9') {
                    digit = 1;
                }
                else {
                    special = 1;
                }
            }

            if (upper == 0 || lower == 0 ||
                digit == 0 || special == 0) {

                printf("Weak Password! Follow all requirements.\n");
                continue;
            }

            file = fopen("users.txt", "a");

            if (file == NULL) {
                printf("File Error!\n");
                continue;
            }

            fprintf(file, "%s %s\n", email, password);

            fclose(file);

            printf("Registration Successful!\n");
        }

        else if (choice == 2) {

            printf("\nLOGIN\n");

            printf("Enter Email: ");
            scanf("%49s", email);

            printf("Enter Password: ");
            scanf("%29s", password);

            file = fopen("users.txt", "r");

            if (file == NULL) {
                printf("No registered account found!\n");
                continue;
            }

            found = 0;

            while (fscanf(file, "%49s %29s",
                          savedEmail, savedPassword) == 2) {

                if (strcmp(email, savedEmail) == 0 &&
                    strcmp(password, savedPassword) == 0) {

                    found = 1;
                    break;
                }
            }

            fclose(file);

            if (found == 1) {
                printf("Login Successful!\n");
                printf("Welcome to Library Management System!\n");
            }
            else {
                printf("Invalid Email or Password!\n");
            }
        }

        else if (choice == 3) {

            printf("Thank You!\n");
            break;
        }

        else {
            printf("Invalid Choice!\n");
        }
    }

    return 0;
}
